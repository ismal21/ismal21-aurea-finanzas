# Copia este archivo a .env y ajusta los valores.
PORT=3000
NODE_ENV=development

# En local, conexión por socket (usuario del sistema, sin contraseña).
# En producción, usa una URL TCP:
# postgresql://usuario:clave@localhost:5432/aurea_finanzas_db
DATABASE_URL=postgresql:///aurea_finanzas_db?host=/var/run/postgresql

# Genera una con: openssl rand -hex 32
SESSION_SECRET=cambia-esta-cadena-por-una-aleatoria
